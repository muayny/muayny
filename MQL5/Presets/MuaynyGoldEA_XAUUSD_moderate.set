; MuaynyGoldEA v3.1 — MODERATE preset for XAUUSD  (risk level ~5-6/10)
; Load in MT5: drop into <MT5 data folder>/MQL5/Presets, then click "Load".
;
; Difference vs the DEFAULT preset:
;   InpBaseRiskPct  0.50 -> 1.00   (risk per trade)
;   InpDailyLossPct 4.0  -> 5.0
;   InpDDStartPct   4.0  -> 5.0
;   InpDDFullPct    12.0 -> 15.0
;   InpBalancePerSlot 5000 -> 3000 ; InpMaxSlotsCap 2 -> 3
;
; Session is entered in THAI time: 07:00 -> 03:00 next day. Set
; InpBrokerGMTOffset to your broker's GMT offset (3 = summer, 2 = winter).
;
; Extra positions are risk-free PYRAMID adds (a new one opens only when the
; existing ones are at break-even). No martingale, no grid, no averaging.
;
; Expect both monthly return AND max drawdown to roughly double vs default.
; NOT investment advice. See docs/RISK_LEVELS.md.

InpTrendTF=16385
InpTrendEMA=50

InpEntryTF=15
InpDonchianLen=20
InpRequireMomentum=true

InpUseStochFilter=true
InpStochBlockExtreme=false
InpStochTF=30
InpStochK=5
InpStochD=3
InpStochSlowing=3
InpStochOB=80
InpStochOS=20

InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdx=18.0

InpAtrPeriod=14
InpAtrAvgPeriod=100
InpAtrLoFactor=0.7
InpAtrHiFactor=3.0

InpBaseRiskPct=1.0
InpAtrSlMult=1.5
InpAtrTpMult=3.0
InpMaxLot=5.0
InpMinLot=0.01

InpAdaptiveRisk=true
InpDDStartPct=5.0
InpDDFullPct=15.0
InpRiskFloorFrac=0.35

InpUseDailyStop=true
InpDailyLossPct=5.0

InpUsePartialTP=true
InpPartialAtr=1.2
InpPartialPct=50.0
InpUseBreakEven=true
InpBreakEvenAtr=0.7
InpUseTrailing=true
InpTrailStartAtr=1.0
InpTrailAtrMult=1.2

InpFailBreakoutExit=true
InpTrendFlipExit=true
InpMaxBarsInLoss=10

InpMaxSpreadAtrFrac=0.25
InpMaxSpreadHardPts=80

InpHoursInThaiTime=true
InpBrokerGMTOffset=3
InpStartHour=7
InpEndHour=3
InpAvoidFriday=true

InpDynamicSlots=true
InpBalancePerSlot=3000.0
InpMaxSlotsCap=3
InpPyramidRiskFree=true
InpMaxPositions=1

InpUseWeekendExit=true
InpBlockNewMins=120
InpCloseAllMins=15

InpProtectManual=true
InpManualSlAtrMult=3.0

InpShowDashboard=true

InpMagic=20260520
InpComment=MuaynyGold
