; MuaynyGoldEA v3.1 — DEFAULT (conservative) preset for XAUUSD  (risk ~3-4/10)
; Load in MT5: drop into <MT5 data folder>/MQL5/Presets, then click "Load".
;
; Session is entered in THAI time (ICT, UTC+7): 07:00 -> 03:00 next day.
; The EA converts it to broker server time using InpBrokerGMTOffset.
;   InpBrokerGMTOffset = 3  -> typical retail broker in summer (GMT+3)
;   InpBrokerGMTOffset = 2  -> winter (GMT+2)
; The EA prints the resolved server window + a detected-offset check to the
; Experts log at attach. If trades fire at the wrong time, fix the offset.
;
; One position at a time at this balance; dynamic slots only unlock more
; as the account grows. No martingale, no grid, no averaging down.
;
; NOT investment advice. Backtest and forward-test before going live.

InpTrendTF=16385
InpTrendEMA=50

InpEntryTF=15
InpDonchianLen=20
InpRequireMomentum=true

InpUseStochFilter=true
InpStochBlockExtreme=false
InpStochTF=30
InpStochK=5
InpStochD=3
InpStochSlowing=3
InpStochOB=80
InpStochOS=20

InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdx=18.0

InpUseRegimeFilter=true
InpEfficiencyPeriod=14
InpMinEfficiency=0.35

InpAtrPeriod=14
InpAtrAvgPeriod=100
InpAtrLoFactor=0.7
InpAtrHiFactor=3.0

InpBaseRiskPct=0.5
InpAtrSlMult=1.5
InpAtrTpMult=3.0
InpMaxLot=5.0
InpMinLot=0.01

InpAdaptiveRisk=true
InpDDStartPct=4.0
InpDDFullPct=12.0
InpRiskFloorFrac=0.35

InpUseDailyStop=true
InpDailyLossPct=4.0

InpUsePartialTP=true
InpPartialAtr=1.2
InpPartialPct=50.0
InpUseBreakEven=true
InpBreakEvenAtr=0.7
InpUseTrailing=true
InpTrailStartAtr=1.0
InpTrailAtrMult=1.2

InpFailBreakoutExit=true
InpTrendFlipExit=true
InpMaxBarsInLoss=10

InpMaxSpreadAtrFrac=0.25
InpMaxSpreadHardPts=80

InpHoursInThaiTime=true
InpBrokerGMTOffset=3
InpStartHour=7
InpEndHour=3
InpAvoidFriday=true

InpDynamicSlots=true
InpBalancePerSlot=5000.0
InpMaxSlotsCap=2
InpPyramidRiskFree=true
InpMaxPositions=1

InpUseWeekendExit=true
InpBlockNewMins=120
InpCloseAllMins=15

InpProtectManual=true
InpManualSlAtrMult=3.0

InpShowDashboard=true

InpMagic=20260520
InpComment=MuaynyGold
