; MuaynyGoldEA default preset for XAUUSD (high-volatility regime)
; Load in MT5: drop into <MT5 data folder>/MQL5/Presets, then in Strategy Tester
; or on an attached chart click "Load" and pick this file.
;
; Defaults assume:
;   - Broker server time = GMT+2 or GMT+3 (typical retail). Adjust StartHour/EndHour
;     if your broker uses a different server clock.
;   - 5-digit XAUUSD pricing (1 point = 0.01 USD).
;
; NOT investment advice. Tune to your broker's spread and your own risk tolerance.

InpTrendTF=16385
InpTrendEMA=50

InpEntryTF=15
InpDonchianLen=20
InpRequireMomentum=true

InpAtrPeriod=14
InpMinAtrPoints=100
InpMaxAtrPoints=1500

InpRiskPercent=0.5
InpAtrSlMult=1.5
InpAtrTpMult=2.5
InpMaxLot=2.0
InpMinLot=0.01

InpUseDailyStop=true
InpDailyLossPct=3.0

InpUseTrailing=true
InpTrailStartAtr=1.0
InpTrailAtrMult=1.2
InpBreakEvenFirst=true
InpBreakEvenAtr=0.6

InpMaxSpreadPts=50
InpStartHour=13
InpEndHour=22
InpAvoidFriday=true
InpMaxPositions=1

InpMagic=20260520
InpComment=MuaynyGold
